# Example environment file for dealdesk — copy to /etc/dealdesk/dealdesk.env.
#
# Every DEALDESK_ variable here maps onto a configuration key Program.cs reads:
# the prefix is stripped and a double underscore becomes a colon, so
# DEALDESK_Db__Path is the key `Db:Path`. Nothing else is read from the
# environment, and every one of these has a working default — an operator who
# copies this file unedited gets a service that runs.

# Where the SQLite file lives. Relative paths resolve against the unit's
# WorkingDirectory; this absolute one is the same directory said out loud.
# Default: dealdesk.db beside the process.
DEALDESK_Db__Path=/var/lib/dealdesk/dealdesk.db

# Where the JSONL ops ledger is appended — one line per request, carrying the
# request path that the /metrics labels deliberately leave out. It grows
# without bound, so point logrotate at it. Default: ledger.jsonl beside the
# process. Blank it to turn the ledger off on a host that ships its own
# request log.
DEALDESK_Ops__LedgerPath=/var/lib/dealdesk/ledger.jsonl

# The static bearer token guarding POST, PUT, PATCH and DELETE. Reads,
# /healthz, /metrics and the desk page stay open whatever this says. Left
# unset, writes are open too — which is what the README quickstart runs
# against, and is why this line is commented out rather than shipped with a
# value somebody would forget to change. Invent a long random string.
# DEALDESK_Auth__Token=change-me-before-anyone-can-reach-this

# The address Kestrel listens on. Read by ASP.NET Core itself rather than by
# dealdesk. Loopback by default here: dealdesk has no TLS and no users beyond
# the token above, so a reverse proxy belongs in front of it.
ASPNETCORE_URLS=http://127.0.0.1:5000
ASPNETCORE_ENVIRONMENT=Production

# Where the single-file binary unpacks the native SQLite library it carries.
# Under the state directory rather than /tmp, so the unpacked copy survives a
# reboot and stays inside the unit's ReadWritePaths.
DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/lib/dealdesk/bundle
